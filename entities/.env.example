# Local Compose defaults. Replace credentials before using external services.
ENVIRON=dev
POSTGRES_USER=test_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_DB_PORT=5432
POSTGRES_DB=cars_and_beyond
# Each API/worker process owns its pool. Defaults retain the existing capacity.
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO_SQL=false
SECRET_KEY_ACCESS=replace-with-a-random-access-key
SECRET_KEY_REFRESH=replace-with-a-random-refresh-key
SECRET_KEY_USER_INTERACTION=replace-with-a-random-interaction-key
JWT_SIGNING_ALGORITHM=HS256
ACCESS_KEY_TIMEDELTA_MINUTES=5
REFRESH_KEY_TIMEDELTA_MINUTES=10
USER_INTERACTION_KEY_TIMEDELTA_DAYS=1
COOKIE_PATH=/
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax
SMTP_SERVER=localhost
SMTP_PORT=1025
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
EMAIL_FROM=replace-me@example.com
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ROOT_USER=replace-me
MINIO_ROOT_PASSWORD=replace-me
MINIO_STORAGE=cars-and-beyond
APICAR_KEY=replace-me
PARSERS_AUTH_TOKEN=replace-me
# Former parsers ENVIRON; independent of the API/database environment.
PARSING_ENVIRON=prod
DC_USERNAME=replace-me
DC_PASSWORD=replace-me
# DealerCenter MFA inbox; falls back to SMTP_USER / SMTP_PASSWORD if unset.
DC_SMTP_USER=replace-me
DC_SMTP_PASSWORD=replace-me
ENTITIES_BROKER_URL=redis://redis:6379/1
ENTITIES_RESULT_BACKEND=redis://redis:6379/1
INTEGRATION_BROKER_URL=redis://redis:6379/0
INTEGRATION_RESULT_BACKEND=redis://redis:6379/0
